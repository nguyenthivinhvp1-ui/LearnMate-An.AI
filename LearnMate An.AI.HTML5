<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>AI Tutor – Trợ lý học tập Socratic</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      background-color: #eef4ff;
      margin: 0; padding: 0;
      display: flex; flex-direction: column; align-items: center;
    }
    h2 {
      background-color: #4b7bec; color: white;
      width: 100%; text-align: center; padding: 15px 0; margin: 0;
    }
    #subject-selection {
      margin-top: 20px;
      text-align: center;
    }
    .subject-btn {
      background-color: #4b7bec; color: white;
      border: none; border-radius: 8px;
      padding: 10px 15px; margin: 5px;
      cursor: pointer; font-size: 15px;
    }
    .subject-btn:hover { background-color: #3867d6; }
    .chatbox {
      width: 90%; max-width: 600px; background: white;
      border-radius: 12px; margin-top: 20px; padding: 15px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      overflow-y: auto; max-height: 70vh;
    }
    .msg { margin: 10px 0; padding: 8px 12px; border-radius: 8px; line-height: 1.4; }
    .user { background-color: #d6e0ff; text-align: right; margin-left: 40px; }
    .ai { background-color: #e8f7e8; text-align: left; margin-right: 40px; }
    .input-area {
      width: 90%; max-width: 600px;
      margin: 15px auto; display: flex; gap: 8px;
    }
    input {
      flex: 1; padding: 10px; border-radius: 8px;
      border: 1px solid #ccc; font-size: 15px;
    }
    button {
      background-color: #4b7bec; color: white;
      border: none; border-radius: 8px;
      padding: 10px 18px; cursor: pointer;
    }
    button:hover { background-color: #3867d6; }
  </style>
</head>

<body>
  <h2>🤖 AI Tutor – Trợ lý học tập Socratic</h2>

  <!-- Chọn môn học -->
  <div id="subject-selection">
    <h3>Em muốn học môn nào hôm nay?</h3>
    <button class="subject-btn" onclick="setSubject('Toán')">🧮 Toán</button>
    <button class="subject-btn" onclick="setSubject('Ngữ văn')">✍️ Ngữ văn</button>
    <button class="subject-btn" onclick="setSubject('Khoa học tự nhiên')">🔬 Khoa học tự nhiên</button>
    <button class="subject-btn" onclick="setSubject('Lịch sử – Địa lí')">🗺️ Lịch sử – Địa lí</button>
    <button class="subject-btn" onclick="setSubject('Tiếng Anh')">🇬🇧 Tiếng Anh</button>
  </div>

  <!-- Khung hội thoại -->
  <div class="chatbox" id="chatbox" style="display:none;">
    <div class="msg ai">🧑‍🏫 LearnMate An.AI: Chào em! Cô rất vui được đồng hành cùng em hôm nay 💬</div>
  </div>

  <!-- Khu nhập liệu -->
  <div class="input-area" id="input-area" style="display:none;">
    <input id="userInput" placeholder="Nhập câu hỏi hoặc nội dung muốn hỏi...">
    <button onclick="sendMessage()">Gửi</button>
  </div>

  <script>
    const API_KEY = "AIzaSyDqVVYRBiopOLYFvGgvnsvHuzi8UIKOcDw"; // ← Dán API key của bạn tại đây
    const API_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=" + API_KEY;

    let subject = "";

    // Khi học sinh chọn môn
    function setSubject(sub) {
      subject = sub;
      document.getElementById("subject-selection").style.display = "none";
      document.getElementById("chatbox").style.display = "block";
      document.getElementById("input-area").style.display = "flex";
      const chat = document.getElementById("chatbox");
      chat.innerHTML += `<div class='msg ai'>🧑‍🏫 LearnMate An.AI: Tuyệt vời! Hôm nay chúng ta sẽ cùng học môn <b>${subject}</b>. Em muốn bắt đầu với phần nào?</div>`;
    }

    async function sendMessage() {
      const inputField = document.getElementById("userInput");
      const chatbox = document.getElementById("chatbox");
      const userText = inputField.value.trim();
      if (!userText) return;

      chatbox.innerHTML += `<div class='msg user'>👩‍🎓 ${userText}</div>`;
      inputField.value = "";
      chatbox.scrollTop = chatbox.scrollHeight;

      chatbox.innerHTML += `<div class='msg ai' id='loading'>🧑‍🏫 LearnMate An.AI: Cô đang suy nghĩ một chút nhé...</div>`;

      const prompt = `
        Bạn là “LearnMate An.AI”, giáo viên THCS dạy môn ${subject}.
        Bạn sử dụng phương pháp Socratic: gợi mở, hỏi dẫn dắt, không cho đáp án trực tiếp.
        Hãy nói chuyện thân thiện, phù hợp học sinh 11–15 tuổi Việt Nam.
        Giọng điệu: gần gũi, khích lệ, luôn hỏi ngược lại để học sinh tự suy luận.
        Dựa trên môn học ${subject}, hãy phản hồi cho câu hỏi sau: "${userText}"
      `;

      try {
        const response = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ role: "user", parts: [{ text: prompt }] }],
          }),
        });

        const data = await response.json();
        document.getElementById("loading").remove();

        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text ||
                      "Xin lỗi, cô chưa hiểu ý em, em nói lại được không?";
        chatbox.innerHTML += `<div class='msg ai'>🧑‍🏫 LearnMate An.AI (${subject}): ${reply}</div>`;
        chatbox.scrollTop = chatbox.scrollHeight;
      } catch (error) {
        document.getElementById("loading").remove();
        chatbox.innerHTML += `<div class='msg ai'>⚠️ Có lỗi khi kết nối tới AI. Vui lòng thử lại sau.</div>`;
      }
    }
  </script>
</body>
</html>

